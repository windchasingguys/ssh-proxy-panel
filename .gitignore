# ============================================================
#  SSH 隧道面板 — 哪些东西不该进版本库
#  规则：源码/文档/示例进库；依赖、构建产物、本机凭据不进库
# ============================================================

# ---------- 依赖与构建产物 ----------
node_modules/
dist/
.build/

# 打包/写入过程中的临时文件（配置是用 <文件>.<pid>.tmp 原子替换的）
*.tmp
*.log

# ---------- 本机敏感数据：绝对不要提交 ----------
# 你的真实隧道地址、边缘机账号、令牌、密码哈希都在这里
tunnels.json
# 运行时状态 + secret.key（加密隧道密码用的本机密钥，泄露等于密码泄露）
.ssh-proxy/
.env
.env.*

# ---------- 测试用的临时目录 ----------
# .tmp-test/ .tmp-demo/ .tmp-diag/ .tmp-ask2/ ... 统一按前缀忽略
.tmp-*/

# ---------- 编辑器 / 操作系统 ----------
.idea/
.openidea/
.vscode/
*.swp
.DS_Store
Thumbs.db
# PowerShell 偶尔会在当前目录生成这个缓存
Microsoft/

# ---------- 说明 ----------
# docs/                  —— README 引用的面板截图，需要进库
# tunnels.example.json   —— 示例配置（不含真实地址），需要进库
# package-lock.json      —— 锁定打包工具的版本，需要进库
